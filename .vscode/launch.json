{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug encrypt_decrypt",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/encrypt_decrypt",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
